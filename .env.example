# ==============================================================================
# Multi-Agent AI Disaster Framework - Environment Variables Template
# Copy this file to '.env' and fill in your credentials before running the pipeline.
# ==============================================================================

# 1. NewsAPI Credentials (Free Tier)
# Register at: https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# 2. Reddit API Credentials (Free Script Application)
# Register app at: https://www.reddit.com/prefs/apps
# Create a "script" application, set redirect URI to http://localhost:8080
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=DisasterMonitor/1.0 (by /u/your_reddit_username)

# 3. Database Connection
# PostgreSQL format: postgresql+asyncpg://disaster_user:disaster_pass@localhost:5432/disaster_db
# SQLite fallback: sqlite+aiosqlite:///./disaster_app.db
DATABASE_URL=postgresql+asyncpg://disaster_user:disaster_pass@localhost:5432/disaster_db
DATABASE_URL_SYNC=postgresql://disaster_user:disaster_pass@localhost:5432/disaster_db

# 4. Redis Queue / Cache Connection
REDIS_URL=redis://localhost:6379/0

# 5. Geocoding User-Agent (Required by Nominatim ToS)
NOMINATIM_USER_AGENT=DisasterVerificationPipeline/1.0
